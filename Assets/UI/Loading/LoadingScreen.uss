VisualElement {
}

.loading-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    display: none;
    overflow: hidden;
}

.loading-background {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.loading-content {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 5%;
    align-items: center;
    justify-content: center;
}

.loading-status {
    width: 100%;
    margin-bottom: 18px;
    color: white;
    font-size: 22px;
    -unity-text-align: middle-center;
}

.loading-bar-fill-clip {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    padding-right: 0;
    background-image: url("project://database/Assets/Images/UI/LoadingBarFill.png?fileID=2800000&guid=2118b30dc6a69234bbf2d4cec9622a11&type=3#LoadingBarFill");
    -unity-slice-type: tiled;
    -unity-slice-left: 32;
    -unity-slice-right: 64;
}

.loading-bar-container {
    position: relative;
    width: 35%;
    height: 64px;
    overflow: hidden;
}

.loading-bar-fill {
    position: absolute;
    left: 0;
    top: 6px;
    width: 0%;
    height: 100%;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    transition-property: width;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    -unity-slice-type: tiled;
}

.loading-bar-frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}
